{
  "$comment": "2026-10-04 已以官网原始 HTML/JSON 实际验证列表选择器、文章路径和发布时间；仅采集公开官方内容。",
  "sources": [
    {
      "id": "supreme-court-news",
      "name": "最高人民法院（最高人民法院新闻）",
      "kind": "web_list",
      "tier": "T1",
      "owner_entity_id": "spc",
      "participation_mode": "editorial",
      "interval_minutes": 1440,
      "tags": ["最高人民法院", "争议/诉讼"],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": true,
      "config": {
        "url": "https://www.court.gov.cn/zixun.html",
        "parseMode": "html",
        "itemSelector": ".lf_news > .content:first-of-type .sec_list li",
        "linkSelector": "a",
        "titleSelector": "a",
        "publishedAtSelector": ".date",
        "publishedAtUtcOffset": "+08:00",
        "allowUrlPrefixes": ["https://www.court.gov.cn/zixun/xiangqing/"],
        "publisherUrlPrefixes": ["https://www.court.gov.cn/zixun/xiangqing/"],
        "sortByPublishedAt": true,
        "detail": {
          "maxFetches": 6,
          "titleSelector": ".detail .title",
          "titleAuthoritative": true,
          "publishedAtRegex": "发布时间[：:]\\s*(\\d{4}-\\d{2}-\\d{2}\\s+\\d{2}:\\d{2}:\\d{2})",
          "publishedAtUtcOffset": "+08:00",
          "upgradeDatePrecision": true
        },
        "_aihot": { "initialBackfillLimit": 6, "initialBackfillMonths": 24 }
      }
    },
    {
